{
  "name": "drwyn-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun run --filter '*' test",
    "build": "bun run --filter @drwyn/react build && bun run --filter @drwyn/memory build && bun run --filter @drwyn/react build && bun run --filter @drwyn/client build",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint --apply .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
